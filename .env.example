# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
APP_NAME=FastAPI Starter
ENVIRONMENT=development
# SQLite for local development; Docker overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./app.db
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=fastapi-starter
JWT_AUDIENCE=fastapi-starter-api
# JSON arrays, not comma-separated strings. Add your frontend's exact origin.
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=app
